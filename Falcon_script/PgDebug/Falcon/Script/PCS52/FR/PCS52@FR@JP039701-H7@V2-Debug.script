	// 条件待ち 1.0s
	WAIT(1000);
	
	timeChecker.StartCheckTime();
	
	// Base：can_on
	ETH_BASE_SEND("./" CMD_can_on);
	ETH_BASE_RECV(ETH_TIMEOUT, false);
	
	while (ETH_BASE_CHKRECV(RES_can_on_1, false))
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		if (10 < timeChecker.CheckTime())
		{
			AbortNG();
		}
	}
	while (ETH_BASE_CHKRECV(RES_can_on_3, false))
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
