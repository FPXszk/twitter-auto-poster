StartStep 690, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 690 //////////");
	etherMidLog.Write("////////// STEP 690 //////////");
	
	bool controls[2];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
//	CONTROL1	レジスタ読出し
	
	// 注39
	// CONTROL1 Mid：DSI1_IRQ_STAT_CLKREF
	ETH_MID_SEND("./" CMD_DSI1_IRQ_STAT_CLKREF);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSI1_IRQ_STAT_CLKREF, false));
	// 注23：8bit目が0なら1、それ以外は0
	// Note：Midだけ8桁0埋めで応答する
	if ((ETH_MID_GETVALUE4() & 0x00000100) == 0x00000000)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_690_DSI1_GCK, 0);
	
//	CONTROL2	レジスタ読出し
	
	// CONTROL2 Mid：DSI2_IRQ_STAT_CLKREF
	ETH_MID_SEND("./" CMD_DSI2_IRQ_STAT_CLKREF);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSI2_IRQ_STAT_CLKREF, false));
	// 注23：8bit目が0なら1、それ以外は0
	// Note：Midだけ8桁0埋めで応答する
	if ((ETH_MID_GETVALUE4() & 0x00000100) == 0x00000000)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_690_DSI2_GCK, 0);
	
EndStep


/*-----------------------------------------------------
	STEP 700 
-----------------------------------------------------*/
StartStep 700, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 700 //////////");
	etherMidLog.Write("////////// STEP 700 //////////");
	
	bool controls[3];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
//	CONTROL1	GPIO書込/読出
//	CONTROL2	GPIO書込/読出
	
	// 注39
	// CONTROL1 Mid：M_DSIPWR_EN_on
	// CONTROL2 Mid：M_VSUP1_EN_off
	ETH_MID_SEND(
		"./"  CMD_M_DSIPWR_EN_on
		"&./" CMD_M_VSUP1_EN_off
		"&");
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL1 Mid：M_DSIPWR_EN_on
		if (!controls[0])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_DSIPWR_EN_on, false) == 0)
			{
				controls[0] = true;
			}
		}
		
		// CONTROL2 Mid：M_VSUP1_EN_off
		if (!controls[1])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_VSUP1_EN_off, false) == 0)
			{
				controls[1] = true;
			}
		}
	}
	while (
		   !controls[0]
		|| !controls[1]
		);
	
//	CONTROL3	GPIO書込/読出
	
	// CONTROL3 Mid：M_VSUP2_EN_off
	ETH_MID_SEND("./" CMD_M_VSUP2_EN_off);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_M_VSUP2_EN_off, false));
	
EndStep


