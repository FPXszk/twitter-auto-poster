StartStep 898, 600000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 898 //////////");
	etherMidLog.Write("////////// STEP 898 //////////");

	// 1. 常温検査のSTEP897終了
	// 2. STEP898開始

	// 3. IPL書込みシェルスクリプト実行（IPL_0.8+WAに書換え）
	// Base側（6GB）
	ETH_BASE_SEND(CMD_IPL_0_8WA_6GB);

	// Mid側（4GB）
	ETH_MID_SEND(CMD_IPL_0_8WA_4GB);

	// 4. reboot
	ETH_BASE_SEND(CMD_REBOOT);
	do {
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	} while (ETH_BASE_CHKRECV(RES_REBOOT, false));
	ETH_MID_SEND(CMD_REBOOT);
	do {
		ETH_MID_RECV(ETH_TIMEOUT, false);
	} while (ETH_MID_CHKRECV(RES_REBOOT, false));

	ETH_BASE_RECV(0, false);
	ETH_MID_RECV(0, false);

	etherBase.Close();
	etherMid.Close();

	// 5. Telnet接続
	WAIT(10000);
	ETH_BASE_OPEN(0);
	ETH_MID_OPEN(0);

	// 6. DQSGateMargin読出しアプリ「DdrReadDQSGateMargin」を実行
	ETH_BASE_SEND(CMD_DdrReadDQSGateMargin);
	do {
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	} while (ETH_BASE_CHKRECV(RES_DdrReadDQSGateMargin, false));
	ETH_MID_SEND(CMD_DdrReadDQSGateMargin);
	do {
		ETH_MID_RECV(ETH_TIMEOUT, false);
	} while (ETH_MID_CHKRECV(RES_DdrReadDQSGateMargin, false));

	// 10. STEP898終了
EndStep



