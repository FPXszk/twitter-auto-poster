	}
	while (ETH_BASE_CHKRECV(RES_CANFD_TRAI_TX, false));
	
	JUDGE_VT(STD_670_CA9_TX, 0);
	
	// CAN受信停止
	IntegCan->stopReceive("CANFD1-1");
	
//	CONTROL6	AD値読出
	
	// CONTROL6  Mid：BU_FANPWR_MONI
	ETH_MID_SEND("./"  CMD_BU_FANPWR_MONI);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_BU_FANPWR_MONI, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_670_F_AD_ON, 0);
	
//	CONTROL7	AD値読出
//	CONTROL8	DM_LED端子の電圧確認(ON時)
	
	// CONTROL7 Base：PB_DM_LED_MONI
	USB_POW_VOLT(PWR1, 14.2);
	WAIT(1000);
	ETH_BASE_SEND("./" CMD_PB_DM_LED_MONI);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}while (ETH_BASE_CHKRECV(RES_PB_DM_LED_MONI, false));
	fVTValue[0] = ETH_BASE_GETVALUE2();
	JUDGE_VT(STD_670_L_AD_ON, 0);
	
	SET_CH_SPEED(2);
	MEAS_VOLT(TP0A03_B0C04,TP0A21_B0C03, "A", 1000, 'M');		// CONTROL8
	JUDGE_VT(STD_670_LED_ON, 0);
	
//	CONTROL9	AD値読出
//	CONTROL10	IR端子の電圧確認(ON時)
	
	// CONTROL9 Mid：IR_MONI
	USB_POW_VOLT(PWR1, 12.0);
	WAIT(1000);
	ETH_MID_SEND("./" CMD_IR_MONI);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_IR_MONI, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_670_I_AD_ON, 0);
	
	SET_CH_SPEED(2);
	MEAS_VOLT(TP0A29_B0C18, TP0A21_B0C03, "A", 1000, 'M');		// CONTROL10
	JUDGE_VT(STD_670_IR_ON, 0);
	USB_POW_VOLT(PWR1, 14.0);
	WAIT(1000);
	
//	CONTROL11	PVMSW端子の電圧確認
	// 注39
	// CONTROL11 Mid：IR_MONI
	ETH_MID_SEND("./" CMD_PVMSW_EN_read);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_PVMSW_EN_read, false));
	// 注15-2:RESULT:0なら0
	if (ETH_MID_GETRESULT() == 0)
	{
		fVTValue[0] = 0;
	}
	else
	{
		fVTValue[0] = 1;
	}
	JUDGE_VT(STD_670_P_EN_ON, 0);
	
//	CONTROL12	GPIO書込/読出
//	CONTROL13	GPIO書込/読出
//	CONTROL14	GPIO書込/読出
//	CONTROL15	GPIO書込/読出
//	CONTROL16	GPIO書込/読出
	
	// CONTROL13 Base：B_SOC_RST_TIMI_read
	// CONTROL16 Base：B_SOC_TIMESYNC_read
	ETH_BASE_SEND(
		"./"  CMD_B_SOC_RST_TIMI_read
		"&./" CMD_B_SOC_TIMESYNC_read
		"&");
	// CONTROL12 Mid：M_SOC_RST_TIMO_read
	// CONTROL14 Mid：M_SOC_RPRG_JDG_read
	// CONTROL15 Mid：M_SOC_SUF_JDG_read
	ETH_MID_SEND(
		"./"  CMD_M_SOC_RST_TIMO_read
		"&./" CMD_M_SOC_RPRG_JDG_read
		"&./" CMD_M_SOC_SUF_JDG_read
		"&");
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL12 Mid：M_SOC_RST_TIMO_read
		if (!controls[11])
		{
			// 注16-2：RESULT:0なら0
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RST_TIMO_read, false) == 0)
			{
				if (ETH_MID_GETRESULT() == 0)
				{
					fVTValue[0] = 0;
				}
				else
				{
					fVTValue[0] = 1;
				}
				controls[11] = true;
			}
		}
		
		// CONTROL13 Base：B_SOC_RST_TIMI_read
		if (!controls[12])
		{
			// 注16-2：RESULT:0なら0
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_RST_TIMI_read, false) == 0)
			{
				if (ETH_BASE_GETRESULT() == 0)
				{
					fVTValue[1] = 0;
				}
				else
				{
					fVTValue[1] = 1;
				}
				controls[12] = true;
			}
		}
		
		// CONTROL14 Mid：M_SOC_RPRG_JDG_read
		if (!controls[13])
		{
			// 注16-2：RESULT:0なら0
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RPRG_JDG_read, false) == 0)
			{
				if (ETH_MID_GETRESULT() == 0)
				{
					fVTValue[2] = 0;
				}
				else
				{
					fVTValue[2] = 1;
				}
			controls[13] = true;
			}
		}
		
		// CONTROL15 Mid：M_SOC_SUF_JDG_read
		if (!controls[14])
		{
			// 注16-2：RESULT:0なら0
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_SUF_JDG_read, false) == 0)
			{
				if (ETH_MID_GETRESULT() == 0)
				{
					fVTValue[3] = 0;
				}
				else
				{
					fVTValue[3] = 1;
				}
				controls[14] = true;
			}
		}
		
		// CONTROL16  Base：B_SOC_TIMESYNC_read
		if (!controls[15])
		{
			// 注16-2：RESULT:0なら0
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_TIMESYNC_read, false) == 0)
			{
				if (ETH_BASE_GETRESULT() == 0)
				{
					fVTValue[4] = 0;
				}
				else
				{
					fVTValue[4] = 1;
				}
				controls[15] = true;
			}
		}
	}
	while (
		   !controls[11]
		|| !controls[12]
		|| !controls[13]
		|| !controls[14]
		|| !controls[15]
		);
	JUDGE_VT(STD_670_B_M_1_L,	0);
	JUDGE_VT(STD_670_B_M_2_L,	1);
	JUDGE_VT(STD_670_B_M_3_L,	2);
	JUDGE_VT(STD_670_B_M_4_L,	3);
	JUDGE_VT(STD_670_B_M_5_L,	4);
	
//	CONTROL17	I2C通信
	
	// CONTROL17 Base：B_PMIC_I2C0
	ETH_BASE_SEND("./" CMD_B_PMIC_I2C0);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_B_PMIC_I2C0, false));
	// 注22：受信データが0x0Aなら1
	if (ETH_BASE_GETVALUE1() == 0x0A)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_670_B_I2C0, 0);
	
//	CONTROL18	I2C通信
	
	// CONTROL18 Mid：M_PMIC_I2C0
	ETH_MID_SEND("./" CMD_M_PMIC_I2C0);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_M_PMIC_I2C0, false));
	// 注22：受信データが0x0Aなら1
	if (ETH_MID_GETVALUE1() == 0x0A)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_670_M_I2C0, 0);
	
//	CONTROL19	メモリ検査
	
	// CONTROL19 Base：base_nor_read
	ETH_BASE_SEND("./" CMD_base_nor_read);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_base_nor_read, false));
	// 注19：受信データが0x5Aなら1
	if (ETH_BASE_GETVALUE1() == 0x5A)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_670_B_NOR_R, 0);
	
//	CONTROL20	メモリ検査
	
	// CONTROL20 Mid：mid_nor_read
	ETH_MID_SEND("./" CMD_mid_nor_read);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_mid_nor_read, false));
	// 注19：受信データが0x5Aなら1
	if (ETH_MID_GETVALUE1() == 0x5A)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_670_M_NOR_R, 0);
	
//	CONTROL21-28	メモリ検査
//	CONTROL29-36	メモリ検査
	
	// CONTROL21 Base：base_emmc_regrd
	ETH_BASE_SEND(CMD_base_emmc_regrd);
	WAIT(500);	// このコマンドの応答は判別できる文字列がないので時間で待機する
	ETH_BASE_RECV(ETH_TIMEOUT);
	
	// 注36
	ETH_BASE_CHKRECV(CMD_base_emmc_regrd);	// 送信コマンドのEchoを探索
	ETH_BASE_CHKRECV("\r\n");				// 送信コマンドのEcho後の改行を探索
	memset(cid, 0x00, sizeof(cid));
	strncpy(cid, base_bufP, 32);			// メモリ文字列をコピー
	fVTValue[0] = Cvt_ASCIItoHEX_4(cid[0], cid[1], cid[2], cid[3]);
	fVTValue[1] = Cvt_ASCIItoHEX_4(cid[4], cid[5], cid[6], cid[7]);
	fVTValue[2] = Cvt_ASCIItoHEX_4(cid[8], cid[9], cid[10], cid[11]);
	fVTValue[3] = Cvt_ASCIItoHEX_4(cid[12], cid[13], cid[14], cid[15]);
	fVTValue[4] = Cvt_ASCIItoHEX_4(cid[16], cid[17], cid[18], cid[19]);
	fVTValue[5] = Cvt_ASCIItoHEX_4(cid[20], cid[21], cid[22], cid[23]);
	fVTValue[6] = Cvt_ASCIItoHEX_4(cid[24], cid[25], cid[26], cid[27]);
	fVTValue[7] = Cvt_ASCIItoHEX_4(cid[28], cid[29], cid[30], cid[31]);
	JUDGE_VT(STD_670_B_EMMC_1, 0);
	JUDGE_VT(STD_670_B_EMMC_2, 1);
	JUDGE_VT(STD_670_B_EMMC_3, 2);
	JUDGE_VT(STD_670_B_EMMC_4, 3);
	JUDGE_VT(STD_670_B_EMMC_5, 4);
	JUDGE_VT(STD_670_B_EMMC_6, 5);
	JUDGE_VT(STD_670_B_EMMC_7, 6);
	JUDGE_VT(STD_670_B_EMMC_8, 7);
	
	// CONTROL29 Mid：mid_emmc_regrd
	ETH_MID_SEND(CMD_mid_emmc_regrd);
	WAIT(500);	// このコマンドの応答は判別できる文字列がないので時間で待機する
	ETH_MID_RECV(ETH_TIMEOUT);
	
	// 注36
	ETH_MID_CHKRECV(CMD_mid_emmc_regrd);	// 送信コマンドのEchoを探索
	ETH_MID_CHKRECV("\r\n");				// 送信コマンドのEcho後の改行を探索
	memset(cid, 0x00, sizeof(cid));
	strncpy(cid, mid_bufP, 32);				// メモリ文字列をコピー
	fVTValue[0] = Cvt_ASCIItoHEX_4(cid[0], cid[1], cid[2], cid[3]);
	fVTValue[1] = Cvt_ASCIItoHEX_4(cid[4], cid[5], cid[6], cid[7]);
	fVTValue[2] = Cvt_ASCIItoHEX_4(cid[8], cid[9], cid[10], cid[11]);
	fVTValue[3] = Cvt_ASCIItoHEX_4(cid[12], cid[13], cid[14], cid[15]);
	fVTValue[4] = Cvt_ASCIItoHEX_4(cid[16], cid[17], cid[18], cid[19]);
	fVTValue[5] = Cvt_ASCIItoHEX_4(cid[20], cid[21], cid[22], cid[23]);
	fVTValue[6] = Cvt_ASCIItoHEX_4(cid[24], cid[25], cid[26], cid[27]);
	fVTValue[7] = Cvt_ASCIItoHEX_4(cid[28], cid[29], cid[30], cid[31]);
	JUDGE_VT(STD_670_M_EMMC_1, 0);
	JUDGE_VT(STD_670_M_EMMC_2, 1);
	JUDGE_VT(STD_670_M_EMMC_3, 2);
	JUDGE_VT(STD_670_M_EMMC_4, 3);
	JUDGE_VT(STD_670_M_EMMC_5, 4);
	JUDGE_VT(STD_670_M_EMMC_6, 5);
	JUDGE_VT(STD_670_M_EMMC_7, 6);
	JUDGE_VT(STD_670_M_EMMC_8, 7);
	
EndStep


