	JUDGE_VT(STD_640_B_V4H2_R, 1);
	JUDGE_VT(STD_640_B_V4H3_R, 2);
	JUDGE_VT(STD_640_B_V4H4_R, 3);
	
//	CONTROL54-57	V4HのDEVUID読み出し
	
	// CONTROL54 Mid：mid_v4h_devuid
	ETH_MID_SEND("./" CMD_mid_v4h_devuid);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL54 Mid：mid_v4h_devuid
		if (!controls[53])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_mid_v4h_devuid_1, false) == 0)
			{
				fVTValue[0] = ETH_MID_GETVALUE2(" ");
				fVTValue[1] = ETH_MID_GETVALUE2();
				controls[53] = true;
			}
		}
		
		if (!controls[55])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_mid_v4h_devuid_2, false) == 0)
			{
				fVTValue[2] = ETH_MID_GETVALUE2(" ");
				fVTValue[3] = ETH_MID_GETVALUE2();
				controls[55] = true;
			}
		}
	}
	while (
		   !controls[53]
		|| !controls[55]
		);
	JUDGE_VT(STD_640_M_V4H1_R, 0);
	JUDGE_VT(STD_640_M_V4H2_R, 1);
	JUDGE_VT(STD_640_M_V4H3_R, 2);
	JUDGE_VT(STD_640_M_V4H4_R, 3);
	
//	SEQ2	+BADAS端子、IGR端子に電圧供給開始
	
	// Ry00
	// Ry01
	// RLY_SET(PATH_RY0_07, "off");
	WAIT(500);
	// Ry12
	// RLY_SET(PATH_RY0_10, "off");
	WAIT(RLY_WAIT);
	
EndStep


