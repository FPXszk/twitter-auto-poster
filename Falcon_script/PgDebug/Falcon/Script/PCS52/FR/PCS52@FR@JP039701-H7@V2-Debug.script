	etherBaseLog.Write("////////// STEP 727 //////////");
	etherMidLog.Write("////////// STEP 727 //////////");
	
	unsigned char o_gpio_h_reg = 0xFF;
	unsigned char o_gpio_l_reg = 0xFF;
	
//	SEQ1	SER_GPIO0出力切替（H出力）
	
	// Mid：M_SER_GPIO0_1
	ETH_MID_SEND("./" CMD_M_SER_GPIO0_1);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_M_SER_GPIO0_1, false));
	
//	SEQ2	SER_GPIO1出力切替（H出力）
	
	// Mid：M_SER_GPIO1_1
