	}
	while (ETH_MID_CHKRECV(RES_BU_FANPWR_MONI, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_640_F_AD_OFF, 0);
	
//	CONTROL26	AD値読出
//	CONTROL27	DM_LED端子の電圧確認(OFF時)
	
	// CONTROL26 Base：PB_DM_LED_MONI
	USB_POW_VOLT(PWR1, 14.2);
	WAIT(1000);
	ETH_BASE_SEND("./" CMD_PB_DM_LED_MONI);
	
	// 計測待ち：1.0s
	WAIT(1000);
	
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_PB_DM_LED_MONI, false));
	fVTValue[0] = ETH_BASE_GETVALUE2();
	JUDGE_VT(STD_640_L_AD_OFF, 0);
	
	SET_CH_SPEED(2);
	MEAS_VOLT(TP0A03_B0C04,TP0A21_B0C03, "A", 1000, 'M');
	JUDGE_VT(STD_640_LED_OFF, 0);
	
//	CONTROL28	AD値読出
//	CONTROL29	IR端子の電圧確認(OFF時)
	
	// CONTROL28 Mid：IR_MONI
	USB_POW_VOLT(PWR1, 12.0);
	WAIT(1000);
	ETH_MID_SEND("./" CMD_IR_MONI);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_IR_MONI, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	fVTValue[0] += OFFSET_I_AD_OFF;			// オフセット
	JUDGE_VT(STD_640_I_AD_OFF, 0);
	
	SET_CH_SPEED(2);
	MEAS_VOLT(TP0A29_B0C18, TP0A21_B0C03, "A", 1000, 'M');	// CONTROL29
	fVTValue[0] += OFFSET_IR_OFF;			// オフセット
	JUDGE_VT(STD_640_IR_OFF, 0);
	USB_POW_VOLT(PWR1, 14.0);
	WAIT(1000);
	
//	CONTROL30	GPIO書込/読出
	
	// 注39
	// CONTROL30 Mid：PVMSW_EN_read
	ETH_MID_SEND("./" CMD_PVMSW_EN_read);
	do
