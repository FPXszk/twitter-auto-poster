StartStep 750, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 750 //////////");
	etherMidLog.Write("////////// STEP 750 //////////");
	
	double pocVolt[7];
	
//	CONTROL1	前方カメラのPoCフィルタの結線設定
//	CONTROL2	前方カメラのPoCフィルタの結線確認
//	CONTROL3	ドラモニのPoCフィルタの結線設定
//	CONTROL4	ドラモニのPoCフィルタの結線確認
//	CONTROL7	後PVMのPoCフィルタの結線設定
//	CONTROL8	後PVMのPoCフィルタの結線確認
//	CONTROL9	前PVMのPoCフィルタの結線設定
//	CONTROL10	前PVMのPoCフィルタの結線確認
//	CONTROL11	左PVMのPoCフィルタの結線設定
//	CONTROL12	左PVMのPoCフィルタの結線確認
//	CONTROL13	右PVMのPoCフィルタの結線設定
//	CONTROL14	右PVMのPoCフィルタの結線確認
	
	MEAS_IMAGE_POC("GVIF1-1");
	MEAS_IMAGE_POC("GVIF1-2");
	MEAS_IMAGE_POC("GVIF1-4");
	MEAS_IMAGE_POC("GVIF1-5");
	MEAS_IMAGE_POC("GVIF1-6");
	MEAS_IMAGE_POC("GVIF1-7");
	
	RUN_MEAS_IMAGE_POC(pocVolt, 2000);
	
	for(int i = 0; i < sizeof(pocVolt); i++)
	{
		fVTValue[i] = pocVolt[i];
	}
	
	JUDGE_VT(STD_750_FCM_POC,	0);
	JUDGE_VT(STD_750_TPVM1_POC,	1);
	JUDGE_VT(STD_750_PVMB_POC,	2);
	JUDGE_VT(STD_750_PVMF_POC,	3);
	JUDGE_VT(STD_750_PVML_POC,	4);
	JUDGE_VT(STD_750_PVMR_POC,	5);
	
EndStep


/*-----------------------------------------------------
	STEP 760 
-----------------------------------------------------*/
StartStep 760, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 760 //////////");
	etherMidLog.Write("////////// STEP 760 //////////");
	
	bool controls[2];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
	WAIT(1000);
	// 読み捨て
	ETH_BASE_RECV(0, false);
	ETH_MID_RECV(0, false);
	
//	CONTROL1	MIPI通信
	
	fVTValue[0] = 0;
	// 注39
	// CONTROL1 Mid：M_SER_GPIO0_mipi
	ETH_MID_SEND("./" CMD_M_SER_GPIO0_mipi);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		if (!controls[0])
		{
			if (ETH_MID_CHKRECV(RES_M_SER_GPIO0_mipi, false) == 0)
			{
				// 注27：OKなら1
				if (ETH_MID_GETOKNG() == 1)
				{
					fVTValue[0] = 1;
				}
				else
				{
					fVTValue[0] = 0;
				}
				controls[0] = true;
			}
			ETH_MID_RESETPOINTER();
		}
	}
	while (ETH_MID_CHKRECV(RES_default, false));	// mipiが成功していないと期待応答しないのでデフォルト待ち
	JUDGE_VT(STD_760_SER_0, 0);
	
//	CONTROL2	MIPI通信
	
	fVTValue[0] = 0;
	// 注39
	// CONTROL2 Mid：M_SER_GPIO1_mipi
	ETH_MID_SEND("./" CMD_M_SER_GPIO1_mipi);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		if (!controls[1])
		{
			if (ETH_MID_CHKRECV(RES_M_SER_GPIO1_mipi, false) == 0)
			{
				// 注27：OKなら1
				if (ETH_MID_GETOKNG() == 1)
				{
					fVTValue[0] = 1;
				}
				else
				{
					fVTValue[0] = 0;
				}
				controls[1] = true;
			}
			ETH_MID_RESETPOINTER();
		}
	}
	while (ETH_MID_CHKRECV(RES_default, false));	// mipiが成功していないと期待応答しないのでデフォルト待ち
	JUDGE_VT(STD_760_SER_1, 0);
	
EndStep


