/*-----------------------------------------------------
	STEP 722 
-----------------------------------------------------*/
StartStep 722, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 722 //////////");
	etherMidLog.Write("////////// STEP 722 //////////");
	
	bool controls[2];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
	WAIT(1000);
	// 読み捨て
	ETH_BASE_RECV(0, false);
	ETH_MID_RECV(0, false);
	
//	CONTROL1	MIPI通信
	
	fVTValue[0] = 0;
	// CONTROL1 Base：OPP_FCM_SER_REG_READ
	ETH_BASE_SEND("./" CMD_OPP_FCM_SER_REG_READ);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		if (!controls[0])
		{
			if (ETH_BASE_CHKRECV(RES_OPP_FCM_SER_REG_READ, false) == 0)
			{
				// 注26：00なら1、それ以外は0
				if (ETH_BASE_CHKVALUE1("00") == 1)
				{
					fVTValue[0] = 1;
				}
				else
				{
					fVTValue[0] = 0;
				}
				controls[0] = true;
			}
			ETH_BASE_RESETPOINTER();
		}
	}
	while (ETH_BASE_CHKRECV(RES_default, false));	// mipiが成功していないと期待応答しないのでデフォルト待ち
	JUDGE_VT(STD_722_OPP_FCM, 0);
	
//	CONTROL2	MIPI通信
	
	fVTValue[0] = 0;
	// CONTROL2 Mid：OPP_PVM_Rr_SER_REG_READ
	ETH_MID_SEND("./" CMD_OPP_PVM_Rr_SER_REG_READ);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		if (!controls[1])
		{
			if (ETH_MID_CHKRECV(RES_OPP_FCM_SER_REG_READ, false) == 0)
			{
				// 注26：00なら1、それ以外は0
				if (ETH_MID_CHKVALUE1("00") == 1)
				{
					fVTValue[0] = 1;
				}
				else
				{
					fVTValue[0] = 0;
				}
				controls[1] = true;
			}
			ETH_MID_RESETPOINTER();
		}
	}
	while (ETH_MID_CHKRECV(RES_default, false));	// mipiが成功していないと期待応答しないのでデフォルト待ち
	JUDGE_VT(STD_722_OPP_PVM, 0);
	
//	SEQ1	前方カメラ、ドラモニ用DESのFSYNC信号設定
//	SEQ2	前方カメラ、ドラモニ用DESのFSYNC信号確認
	
	double syncCycle[1];
	double duty[1];
	
	// 注50
	MEAS_IMAGE_FSYNC("GVIF1-1");
	
	// 現場追加：コマンド～コマンドまでに待ちが必要
	WAIT(5000);
	
	// 注51
	RUN_MEAS_IMAGE_FSYNC(syncCycle, duty, 2000);
	// FSYNC異常の場合対向機リセット
	if (syncCycle[0] == -99)
	{
		gvifRestart = true;
	}
	fVTValue[0] = syncCycle[0] * 0.001;
	JUDGE_VT(STD_722_B_FSYNC, 0);
	
//	SEQ3	PVM用DESのFSYNC信号設定
//	SEQ4	PVM用DESのFSYNC信号確認
	
	// 注50
	MEAS_IMAGE_FSYNC("GVIF1-4");
	
	// 現場追加：コマンド～コマンドまでに待ちが必要
	WAIT(5000);
	
	// 注51
	RUN_MEAS_IMAGE_FSYNC(syncCycle, duty, 2000);
	// FSYNC異常の場合対向機リセット
	if (syncCycle[0] == -99)
	{
		gvifRestart = true;
	}
	fVTValue[0] = syncCycle[0] * 0.001;
	JUDGE_VT(STD_722_M_FSYNC, 0);
	
EndStep


/*-----------------------------------------------------
	STEP 725 
-----------------------------------------------------*/
StartStep 725, 300000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 725 //////////");
	etherMidLog.Write("////////// STEP 725 //////////");
	
	unsigned int imgCompare[2];
	
//	CONTROL1	MIPI通信
	
	// 注39
	// CONTROL1 Mid：MM_mipi
	ETH_MID_SEND("./" CMD_MM_mipi);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_default, false));	// 失敗すると無限ループするのでデフォルト待ち
	
//	CONTROL2	画像判定設定(VCID:0)
	
	// 注47
	gvif_setCompareImage(GVIF_MODLE_IPADDR, 10, FILE_COMPARE_VID0, 0, 0);
	
//	CONTROL3	画像判定設定(VCID:1)
	
	// 注47
	gvif_setCompareImage(GVIF_MODLE_IPADDR, 10, FILE_COMPARE_VID1, 1, 1);

	for (int i = 0; i < 5; i++)
	{
		WAIT(100);
		
//	CONTROL4	画像受信設定(VCID:0)
		
		// 注48
		gvif_setCheckInputImage(GVIF_MODLE_IPADDR, 10, 0);
		
//	CONTROL5	画像受信設定(VCID:1)
		
		// 注48
		gvif_setCheckInputImage(GVIF_MODLE_IPADDR, 10, 1);
		
//	CONTROL6	受信画像判定
		
		gvif_chkInputImage(imgCompare);
		Print("mm result:0x%x, 0x%x", imgCompare[0], imgCompare[1]);
		// 注49：対向機応答が0x1なら1
		if ((imgCompare[0] == 0x1) && (imgCompare[1] == 0x1))
		{
			fVTValue[0] = 1;
			break;
		}
		else
		{
			fVTValue[0] = 0;
			if ((imgCompare[0] == 0x403) || (imgCompare[1] == 0x403))
			{
				Print("Retry Break");
				break;
			}
		}
	}
	JUDGE_VT(STD_725_MM, 0);
	
EndStep


