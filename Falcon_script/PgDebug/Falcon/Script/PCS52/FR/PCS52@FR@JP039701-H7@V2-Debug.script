//			(unsigned char)g_szRecvData[5],
//			(unsigned char)g_szRecvData[6],
//			(unsigned char)g_szRecvData[7]);
		if (((unsigned char)g_szRecvData[0] == 0xF8) &&
		    ((unsigned char)g_szRecvData[1] == 0x3E) &&
		    ((unsigned char)g_szRecvData[2] == 0x0F) &&
		    ((unsigned char)g_szRecvData[3] == 0x83) &&
		    ((unsigned char)g_szRecvData[4] == 0xE0) &&
		    ((unsigned char)g_szRecvData[5] == 0xF8) &&
		    ((unsigned char)g_szRecvData[6] == 0x3E) &&
		    ((unsigned char)g_szRecvData[7] == 0x0F))
		{
			fVTValue[0] = 1;
		}
		else
		{
			fVTValue[0] = 0;
		}
	}
	else
	{
		fVTValue[0] = 0;
	}
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_CANFD_F_TX, false));
	
	JUDGE_VT(STD_670_CA2_TX, 0);
	
	// CAN受信停止
	IntegCan->stopReceive("CANFD2-0");
	
//	CONTROL5	CANFD_TRAI送信
	
	// CAN受信開始
	IntegCan->receiveDataReset("CANFD1-1");
	IntegCan->receive("CANFD1-1", 0, 0x123);
	
	// CONTROL5  Base：CANFD_TRAI_TX
	ETH_BASE_SEND("./"  CMD_CANFD_TRAI_TX);
	
	// 注3：CAN
	memset(g_szRecvData, 0x0, sizeof(g_szRecvData));
	iResult = IntegCan->receiveEvent("CANFD1-1", g_szRecvData, 1, 1500, 8);
	if (iResult == 1)
	{
		IntegCan->receiveData("CANFD1-1", g_szRecvData, 0, 0x123, 0, 0, 0, 7, 8);
		
//		Print("CANFD_TRAI: %02x %02x %02x %02x %02x %02x %02x %02x",
//			(unsigned char)g_szRecvData[0],
//			(unsigned char)g_szRecvData[1],
