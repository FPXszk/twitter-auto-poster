	ETH_MID_SEND("./" CMD_DSI_B_RST_1);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSI_B_RST_1, false));
	
EndStep


