	}
	while (ETH_BASE_CHKRECV(RES_B_CB_PRESET, false));
	// 注17：受信データ(16進数)の0bit目が1なら1
	if ((ETH_BASE_GETVALUE1() & 0x01) == 0x01)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	JUDGE_VT(STD_640_B_PRESET, 0);
	
