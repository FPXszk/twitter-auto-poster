//	SEQ4	検査ソフトVer読出し
	
	// Mid：mid_testsoft_ck
	ETH_MID_SEND("./" CMD_mid_testsoft_ck);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_mid_testsoft_ck, false));
	
	// 注13
	if (ETH_MID_CHKRECV(mid_testsoft_ver, false) == 0)
	{
		fVTValue[0] = 1;
	}
	else
	{
		fVTValue[0] = 0;
	}
	
	JUDGE_VT(STD_600_MSOFT_CK, 0);
	
EndStep


/*-----------------------------------------------------
	STEP 605 
-----------------------------------------------------*/
StartStep 605, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 605 //////////");
	etherMidLog.Write("////////// STEP 605 //////////");
	
	bool ctrl41ck[2];
	for (int i = 0; i < sizeof(ctrl41ck); i++)
	{
		ctrl41ck[i] = false;
	}
	
//	SEQ1	SPI通信
	
	// Base：B_SPI_SoC_ck
	ETH_BASE_SEND("./" CMD_B_SPI_SoC_ck);
	
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		
		// 1行目
		if (!ctrl41ck[0])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SPI_SoC_ck_1, false) == 0)
			{
				// 注18：2行ともOKなら1
				if (ETH_BASE_GETOKNG() == 1)
				{
					fVTValue[0] = 1;
				}
				else
				{
					fVTValue[0] = 0;
				}
				ctrl41ck[0] = true;
			}
		}
		// 2行目
		if (ctrl41ck[0] && !ctrl41ck[1])
		{
			if (fVTValue[0] == 1)
			{
				ETH_BASE_RESETPOINTER();
				if (ETH_BASE_CHKRECV(RES_B_SPI_SoC_ck_2, false) == 0)
				{
					// 注18：2行ともOKなら1
					if (ETH_BASE_GETOKNG() == 1)
					{
						fVTValue[0] = 1;
					}
					else
					{
						fVTValue[0] = 0;
					}
					ctrl41ck[1] = true;
				}
			}
			else
			{
				// 1行目が既にNG
				ctrl41ck[1] = true;
			}
		}
	}
	while (!ctrl41ck[0] || !ctrl41ck[1]);
	JUDGE_VT(STD_605_B_M_SPI, 0);
	
EndStep


/*-----------------------------------------------------
	STEP 610 
-----------------------------------------------------*/
StartStep 610, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 610 //////////");
	etherMidLog.Write("////////// STEP 610 //////////");
	
//	SEQ1	DM_LEDの疑似負荷と接続
	
	// Ry17
	RLY_SET(PATH_Ry17, "on");
	
	WAIT(RLY_WAIT);
	
//	SEQ2	IRの疑似負荷と接続
	
	// Ry14
	RLY_SET(PATH_Ry14, "on");
	// Ry24 不要
	RLY_SET(PATH_Ry24,"on");
	
	WAIT(RLY_WAIT);
	
//	SEQ3	ソナーをAD変換ボードと接続
	
	// Ry25 不要
	RLY_SET(PATH_Ry25,"on");
	// Ry26 不要
	RLY_SET(PATH_Ry26,"on");
	// Ry27 不要
	RLY_SET(PATH_Ry27,"on");
	// Ry30 不要
	RLY_SET(PATH_Ry30,"on");
	// Ry31 不要
	RLY_SET(PATH_Ry31,"on");
	// Ry32 不要
	RLY_SET(PATH_Ry32,"on");
	// Ry33 不要
	RLY_SET(PATH_Ry33,"on");
	// Ry34 不要
	RLY_SET(PATH_Ry34,"on");
	
EndStep


/*-----------------------------------------------------
	STEP 625 
-----------------------------------------------------*/
StartStep 625, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 625 //////////");
	etherMidLog.Write("////////// STEP 625 //////////");
	
	int setParamResult = 0;
	bool check_dmc = false;
	bool check_mm = false;
	bool check_pvm = false;
	
	// 読み捨て
	ETH_BASE_RECV(0, false);
	ETH_MID_RECV(0, false);
	
//	SEQ1	パラメータ設定（MM）
	
	for (int i = 0; i < 5; i++)
	{
		// 注43
		setParamResult = gvif_setParams(GVIF_MODLE_IPADDR, 10, FILE_SETPARAM_MM);
		if (setParamResult != 0)
		{
			Print("setParam Error:%x", setParamResult);
			
			if (i != 4)
			{
				gvif_initialize(GVIF_MODLE_IPADDR, 1);
				
				ETH_BASE_SEND("./" CMD_B_mipi_init);
				ETH_MID_SEND("./" CMD_M_mipi_init);
				
				WAIT(1000);
			}
		}
		else
		{
			break;
		}
	}
	
	// DEBUG: handshake for GVIF1-4 after setParams, before OUTPUT_IMAGE_SET
	IMAGE_HANDSHAKE_SET("GVIF1-4", 30);
//	SEQ2	出力画像設定（FCM）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-1
	OUTPUT_IMAGE_SET("GVIF1-1", FILE_OUTPUT_FCM);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-1
	
//	SEQ3	出力画像設定（TPVM1）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-3
	OUTPUT_IMAGE_SET("GVIF1-3", FILE_OUTPUT_TPVM1);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-3
	
//	SEQ5	出力画像設定（PVMRr）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-4
	OUTPUT_IMAGE_SET("GVIF1-4", FILE_OUTPUT_REAR);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-4
	
//	SEQ6	出力画像設定（PVMFr）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-5
	OUTPUT_IMAGE_SET("GVIF1-5", FILE_OUTPUT_FRONT);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-5
	
//	SEQ7	出力画像設定（PVMLh）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-6
	OUTPUT_IMAGE_SET("GVIF1-6", FILE_OUTPUT_LEFT);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-6
	
//	SEQ8	出力画像設定（PVMRh）
	
	// 注44
	WAIT(1000);	// DEBUG: pre-wait OUTPUT_IMAGE_SET GVIF1-7
	OUTPUT_IMAGE_SET("GVIF1-7", FILE_OUTPUT_RIGHT);
	WAIT(1000);	// DEBUG: post-wait OUTPUT_IMAGE_SET GVIF1-7
	
//	SEQ9	画像出力（FCM）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-1
	IMAGE_OUTPUT("GVIF1-1", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-1
	
//	SEQ10	画像出力（TPVM1）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-3
	IMAGE_OUTPUT("GVIF1-3", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-3
	
//	SEQ12	画像出力（PVMRr）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-4
	IMAGE_OUTPUT("GVIF1-4", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-4
	
//	SEQ13	画像出力（PVMFr）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-5
	IMAGE_OUTPUT("GVIF1-5", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-5
	
//	SEQ14	画像出力（PVMLh）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-6
	IMAGE_OUTPUT("GVIF1-6", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-6
	
//	SEQ15	画像出力（PVMRh）
	
	// 注45
	WAIT(1000);	// DEBUG: pre-wait IMAGE_OUTPUT GVIF1-7
	IMAGE_OUTPUT("GVIF1-7", 0);
	WAIT(1000);	// DEBUG: post-wait IMAGE_OUTPUT GVIF1-7
	
	WAIT(3000);
	
	// mipiハンドシェイク成功確認
	ETH_BASE_RECV(0, false);
	ETH_MID_RECV(0, false);
	
	if (!check_dmc)
	{
		if (ETH_BASE_CHKRECV("[init]CXD4966(Des_FRONT, T-PVM1) ", false) == 0)
		{
			if (strncmp(base_bufP, message_sequence_ok, sizeof(message_sequence_ok)) == 0)
			{
				fVTValue[0] = 1;
				check_dmc = true;
//				Print("mipi init DMC OK");
			}
			else
			{
				fVTValue[0] = 0;
				check_dmc = true;
				Print("mipi init TPVM1 NG");
			}
		}
		else
		{
			fVTValue[0] = -1;
			Print("mipi init TPVM1 result message is not found.");
		}
	}
	ETH_BASE_RESETPOINTER();
	
	if (!check_mm)
	{
		if (ETH_MID_CHKRECV("[init]CXD4967(Ser_MM) ", false) == 0)
		{
			if (strncmp(mid_bufP, message_sequence_ok, sizeof(message_sequence_ok)) == 0)
			{
				fVTValue[1] = 1;
				check_mm = true;
//				Print("mipi init MM OK");
			}
			else
			{
				fVTValue[1] = 0;
				check_mm = true;
				Print("mipi init MM NG");
			}
		}
		else
		{
			fVTValue[1] = -1;
			Print("mipi init MM result message is not found.");
		}
	}
	ETH_MID_RESETPOINTER();
	
	if (!check_pvm)
	{
		if (ETH_MID_CHKRECV("[init]CXD4964(Des_PVM) ", false) == 0)
		{
			if (strncmp(mid_bufP, message_sequence_ok, sizeof(message_sequence_ok)) == 0)
			{
				fVTValue[2] = 1;
				check_pvm = true;
//				Print("mipi init PVM OK");
			}
			else
			{
				fVTValue[2] = 0;
				check_pvm = true;
				Print("mipi init PVM NG");
			}
		}
		else
		{
			fVTValue[2] = -1;
			Print("mipi init PVM result message is not found.");
		}
	}
	ETH_MID_RESETPOINTER();
	
	Judge(fVTValue[0], "=", 1, "", "MIPI_TPVM1", 0, "", true);
	JudgeCounter::GetInstance().CountUp(1);
	Judge(fVTValue[1], "=", 1, "", "MIPI_MM", 0, "", true);
	JudgeCounter::GetInstance().CountUp(1);
	Judge(fVTValue[2], "=", 1, "", "MIPI_PVM", 0, "", true);
	JudgeCounter::GetInstance().CountUp(1);
	
EndStep


/*-----------------------------------------------------
	STEP 630 
-----------------------------------------------------*/
StartStep 630, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 630 //////////");
	etherMidLog.Write("////////// STEP 630 //////////");
	
	bool controls[5];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
//	CONTROL1	GPIO書込/読出
//	CONTROL2	GPIO書込/読出
//	CONTROL3	GPIO書込/読出
//	CONTROL4	GPIO書込/読出
//	CONTROL5	GPIO書込/読出
	
	// CONTROL1 Base：B_SOC_RST_TIMO_write_1
	// CONTROL3 Base：B_SOC_RPRG_JDG_write_1
	// CONTROL4 Base：B_SOC_SUF_JDG_write_1
	ETH_BASE_SEND(
		"./"  CMD_B_SOC_RST_TIMO_write_1			// CONTROL1
		"&./" CMD_B_SOC_RPRG_JDG_write_1			// CONTROL3
		"&./" CMD_B_SOC_SUF_JDG_write_1				// CONTROL4
		"&");
	// CONTROL2 Mid：M_SOC_RST_TIMI_write_1
	// CONTROL5 Mid：M_SOC_TIMESYNC_write_1
	ETH_MID_SEND(
		"./"  CMD_M_SOC_RST_TIMI_write_1			// CONTROL2
		"&./" CMD_M_SOC_TIMESYNC_write_1			// CONTROL5
		"&");
	
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL1 Base：B_SOC_RST_TIMO_write_1
		if (!controls[0])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_RST_TIMO_write_1, false) == 0)
			{
				controls[0] = true;
			}
		}
		
		// CONTROL2 Mid：M_SOC_RST_TIMI_write_1
		if (!controls[1])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RST_TIMI_write_1, false) == 0)
			{
				controls[1] = true;
			}
		}
		
		// CONTROL3 Base：B_SOC_RPRG_JDG_write_1
		if (!controls[2])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_RPRG_JDG_write_1, false) == 0)
			{
				controls[2] = true;
			}
		}
		
		// CONTROL4 Base：B_SOC_SUF_JDG_write_1
		if (!controls[3])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_SUF_JDG_write_1, false) == 0)
			{
				controls[3] = true;
			}
		}
		
		// CONTROL5  Mid：M_SOC_TIMESYNC_write_1
		if (!controls[4])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_TIMESYNC_write_1, false) == 0)
			{
				controls[4] = true;
			}
		}
	}
	while (
		   !controls[0]
		|| !controls[1]
		|| !controls[2]
		|| !controls[3]
		|| !controls[4]
		);
	
EndStep


/*-----------------------------------------------------
	STEP 640 
-----------------------------------------------------*/
StartStep 640, 120000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 640 //////////");
	etherMidLog.Write("////////// STEP 640 //////////");
	
	bool controls[57];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
	float canWave[20];
	for (int i = 0; i < sizeof(canWave); i++)
	{
		canWave[i] = 0;
	}
	bool retryFlag = false;
	
/*
//	SEQ1	+BADAS端子にシャント抵抗を接続して電圧供給開始
	
	// Ry12
	// RLY_SET(PATH_RY0_10, "on");
	WAIT(500);
	// Ry00
	// Ry01
	// RLY_SET(PATH_RY0_07, "on");
	
//	CONTROL1	+BADAS端子消費電流値確認
	
	// 計測待ち 10.0s
	WAIT(10000);
	
	MEAS_DMMC("34461A-1-A", 2.999, "A", 4, DMM_FAST);			// CONTROL1
	JUDGE_VT(STD_640_PB_I, 0);
	*/
	WAIT(10000); //STEP移動させたので意図的にwait追加
	
//////////////////// CAN波形 リトライ ////////////////////
	
	char waveFileName_H[128];
	char waveFileName_L[128];
	
	bRetryFlag = true;
	RETRY(10)
	
	retryFlag = false;
	
//	CONTROL2	CANFD_CENT_Hレセッシブ電圧確認
//	CONTROL3	CANFD_CENT_Lレセッシブ電圧確認
//	CONTROL4	CANFD_CENT_Hドミナント電圧確認
//	CONTROL5	CANFD_CENT_Lドミナント電圧確認
	
	memset(waveFileName_H, 0, sizeof(waveFileName_H));
	memset(waveFileName_L, 0, sizeof(waveFileName_L));
	
	SET_CH_SPEED(0.2);
	MEAS_VOLT_BG_ADC(TP0A22_B0C05, TP0A21_B0C03, "A", 40000, 'S', ALL_ADC);		// CONTROL2-5
	MEAS_VOLT_BG_ADC(TP0A04_B0C06, TP0A21_B0C03, "A", 40000, 'M', ALL_ADC);		// CONTROL2-5
	MEAS_GET_ADC(ALL_ADC);
	MEAS_VCAN_DR(TP0A22_B0C05, TP0A04_B0C06, 2.75, 2.25);
	if (iResult != 0)
	{
		retryFlag = true;
		fVTValue[0] = -1;
		fVTValue[1] = -1;
		fVTValue[2] = -1;
		fVTValue[3] = -1;
		
		sprintf(waveFileName_H, "STEP640_CONTROL2-5_CANFD_CENT_H_%d_NG", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL2-5_CANFD_CENT_L_%d_NG", iCnt);
	}
	else
	{
		sprintf(waveFileName_H, "STEP640_CONTROL2-5_CANFD_CENT_H_%d", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL2-5_CANFD_CENT_L_%d", iCnt);
	}
	canWave[0] = fVTValue[0];
	canWave[1] = fVTValue[1];
	canWave[2] = fVTValue[2];
	canWave[3] = fVTValue[3];
	
	if (iResult != 0)
	{
		waveWriter.Output(TP0A22_B0C05, 2, waveFileName_H);
		waveWriter.Output(TP0A04_B0C06, 1, waveFileName_L);
	}
	
//	CONTROL6	CANFD_FR_FL_Hレセッシブ電圧確認
//	CONTROL7	CANFD_FR_FL_Lレセッシブ電圧確認
//	CONTROL8	CANFD_FR_FL_Hドミナント電圧確認
//	CONTROL9	CANFD_FR_FL_Lドミナント電圧確認
	
	memset(waveFileName_H, 0, sizeof(waveFileName_H));
	memset(waveFileName_L, 0, sizeof(waveFileName_L));
	
	SET_CH_SPEED(0.2);
	MEAS_VOLT_BG_ADC(TP0A23_B0C07, TP0A21_B0C03, "A", 40000, 'S', ALL_ADC);		// CONTROL6-9
	MEAS_VOLT_BG_ADC(TP0A05_B0C08, TP0A21_B0C03, "A", 40000, 'M', ALL_ADC);		// CONTROL6-9
	MEAS_GET_ADC(ALL_ADC);
	MEAS_VCAN_DR(TP0A23_B0C07, TP0A05_B0C08, 2.75, 2.25);
	if (iResult != 0)
	{
		retryFlag = true;
		fVTValue[0] = -1;
		fVTValue[1] = -1;
		fVTValue[2] = -1;
		fVTValue[3] = -1;
		
		sprintf(waveFileName_H, "STEP640_CONTROL6-9_CANFD_FR_FL_H_%d_NG", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL6-9_CANFD_FR_FL_L_%d_NG", iCnt);
	}
	else
	{
		sprintf(waveFileName_H, "STEP640_CONTROL6-9_CANFD_FR_FL_H_%d", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL6-9_CANFD_FR_FL_L_%d", iCnt);
	}
	canWave[4] = fVTValue[0];
	canWave[5] = fVTValue[1];
	canWave[6] = fVTValue[2];
	canWave[7] = fVTValue[3];
	
	if (iResult != 0)
	{
		waveWriter.Output(TP0A23_B0C07, 2, waveFileName_H);
		waveWriter.Output(TP0A05_B0C08, 1, waveFileName_L);
	}
	
//	CONTROL10	CANFD_RR_RL_Hレセッシブ電圧確認
//	CONTROL11	CANFD_RR_RL_Lレセッシブ電圧確認
//	CONTROL12	CANFD_RR_RL_Hドミナント電圧確認
//	CONTROL13	CANFD_RR_RL_Lドミナント電圧確認
	
	memset(waveFileName_H, 0, sizeof(waveFileName_H));
	memset(waveFileName_L, 0, sizeof(waveFileName_L));
	
	SET_CH_SPEED(0.2);
	MEAS_VOLT_BG_ADC(TP0A24_B0C09, TP0A21_B0C03, "A", 40000, 'S', ALL_ADC);		// CONTROL10-13
	MEAS_VOLT_BG_ADC(TP0A06_B0C10, TP0A21_B0C03, "A", 40000, 'M', ALL_ADC);		// CONTROL10-13
	MEAS_GET_ADC(ALL_ADC);
	MEAS_VCAN_DR(TP0A24_B0C09, TP0A06_B0C10, 2.75, 2.25);
	if (iResult != 0)
	{
		retryFlag = true;
		fVTValue[0] = -1;
		fVTValue[1] = -1;
		fVTValue[2] = -1;
		fVTValue[3] = -1;
		
		sprintf(waveFileName_H, "STEP640_CONTROL10-13_CANFD_RR_RL_H_%d_NG", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL10-13_CANFD_RR_RL_L_%d_NG", iCnt);
	}
	else
	{
		sprintf(waveFileName_H, "STEP640_CONTROL10-13_CANFD_RR_RL_H_%d", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL10-13_CANFD_RR_RL_L_%d", iCnt);
	}
	canWave[8] = fVTValue[0];
	canWave[9] = fVTValue[1];
	canWave[10] = fVTValue[2];
	canWave[11] = fVTValue[3];
	
	if (iResult != 0)
	{
		waveWriter.Output(TP0A24_B0C09, 2, waveFileName_H);
		waveWriter.Output(TP0A06_B0C10, 1, waveFileName_L);
	}
	
//	CONTROL14	CANFD_TRAI_Hレセッシブ電圧確認
//	CONTROL15	CANFD_TRAI_Lレセッシブ電圧確認
//	CONTROL16	CANFD_TRAI_Hドミナント電圧確認
//	CONTROL17	CANFD_TRAI_Lドミナント電圧確認
	
	memset(waveFileName_H, 0, sizeof(waveFileName_H));
	memset(waveFileName_L, 0, sizeof(waveFileName_L));
	
	SET_CH_SPEED(0.2);
	MEAS_VOLT_BG_ADC(TP0A25_B0C11, TP0A21_B0C03, "A", 40000, 'S', ALL_ADC);		// CONTROL14-17
	MEAS_VOLT_BG_ADC(TP0A07_B0C12, TP0A21_B0C03, "A", 40000, 'M', ALL_ADC);		// CONTROL14-17
	MEAS_GET_ADC(ALL_ADC);
	MEAS_VCAN_DR(TP0A25_B0C11, TP0A07_B0C12, 2.89, 2.13);
	if (iResult != 0)
	{
		retryFlag = true;
		fVTValue[0] = -1;
		fVTValue[1] = -1;
		fVTValue[2] = -1;
		fVTValue[3] = -1;
		
		sprintf(waveFileName_H, "STEP640_CONTROL14-17_CANFD_TRAI_H_%d_NG", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL14-17_CANFD_TRAI_L_%d_NG", iCnt);
	}
	else
	{
		sprintf(waveFileName_H, "STEP640_CONTROL14-17_CANFD_TRAI_H_%d", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL14-17_CANFD_TRAI_L_%d", iCnt);
	}
	canWave[12] = fVTValue[0];
	canWave[13] = fVTValue[1];
	canWave[14] = fVTValue[2];
	canWave[15] = fVTValue[3];
	
	if (iResult != 0)
	{
		waveWriter.Output(TP0A25_B0C11, 2, waveFileName_H);
		waveWriter.Output(TP0A07_B0C12, 1, waveFileName_L);
	}
	
//	CONTROL18	CANFD_F_Hレセッシブ電圧確認
//	CONTROL19	CANFD_F_Lレセッシブ電圧確認
//	CONTROL20	CANFD_F_Hドミナント電圧確認
//	CONTROL21	CANFD_F_Lドミナント電圧確認
	
	memset(waveFileName_H, 0, sizeof(waveFileName_H));
	memset(waveFileName_L, 0, sizeof(waveFileName_L));
	
	SET_CH_SPEED(0.2);
	MEAS_VOLT_BG_ADC(TP0A26_B0C13, TP0A21_B0C03, "A", 40000, 'S', ALL_ADC);		// CONTROL18-21
	MEAS_VOLT_BG_ADC(TP0A08_B0C14, TP0A21_B0C03, "A", 40000, 'M', ALL_ADC);		// CONTROL18-21
	MEAS_GET_ADC(ALL_ADC);
	MEAS_VCAN_DR(TP0A26_B0C13, TP0A08_B0C14, 2.75, 2.25);
	if (iResult != 0)
	{
		retryFlag = true;
		fVTValue[0] = -1;
		fVTValue[1] = -1;
		fVTValue[2] = -1;
		fVTValue[3] = -1;
		
		sprintf(waveFileName_H, "STEP640_CONTROL18-21_CANFD_F_H_%d_NG", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL18-21_CANFD_F_L_%d_NG", iCnt);
	}
	else
	{
		sprintf(waveFileName_H, "STEP640_CONTROL18-21_CANFD_F_H_%d", iCnt);
		sprintf(waveFileName_L, "STEP640_CONTROL18-21_CANFD_F_L_%d", iCnt);
	}
	canWave[16] = fVTValue[0];
	canWave[17] = fVTValue[1];
	canWave[18] = fVTValue[2];
	canWave[19] = fVTValue[3];
	
	if (iResult != 0)
	{
		waveWriter.Output(TP0A26_B0C13, 2, waveFileName_H);
		waveWriter.Output(TP0A08_B0C14, 1, waveFileName_L);
	}
	
	if (bRetryFlag)
	{
		if (retryFlag)
		{
			Print("Meas CAN Wave Retry");
			etherBaseLog.Write("////////// Meas CAN Wave Retry //////////");
			
			ETH_BASE_SEND("./" CMD_can_off);
			do
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
			}
			while (ETH_BASE_CHKRECV(RES_can_off, false));
			
			WAIT(1000);
			
			timeChecker.StartCheckTime();
		
			// Base：can_on
			ETH_BASE_SEND("./" CMD_can_on);
			ETH_BASE_RECV(ETH_TIMEOUT, false);
			
			while (ETH_BASE_CHKRECV(RES_can_on_1, false))
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
				if (10 < timeChecker.CheckTime())
				{
					AbortNG();
				}
			}
			while (ETH_BASE_CHKRECV(RES_can_on_3, false))
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
				if (10 < timeChecker.CheckTime())
				{
					AbortNG();
				}
			}
			while (ETH_BASE_CHKRECV(RES_can_on_4, false))
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
				if (10 < timeChecker.CheckTime())
				{
					AbortNG();
				}
			}
			while (ETH_BASE_CHKRECV(RES_can_on_5, false))
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
				if (10 < timeChecker.CheckTime())
				{
					AbortNG();
				}
			}
			while (ETH_BASE_CHKRECV(RES_can_on_7, false))
			{
				ETH_BASE_RECV(ETH_TIMEOUT, false);
				if (10 < timeChecker.CheckTime())
				{
					AbortNG();
				}
			}
		}
		else
		{
			bRetryFlag = false;
		}
	}
	
	RETRY_END
	
	for (int i = 0; i < sizeof(canWave); i++)
	{
		fVTValue[i] = canWave[i];
	}
	JUDGE_VT(STD_640_CA1H_R,	0);
	JUDGE_VT(STD_640_CA1L_R,	1);
	JUDGE_VT(STD_640_CA1H_D,	2);
	JUDGE_VT(STD_640_CA1L_D,	3);
	JUDGE_VT(STD_640_CA5_6H_R,	4);
	JUDGE_VT(STD_640_CA5_6L_R,	5);
	JUDGE_VT(STD_640_CA5_6H_D,	6);
	JUDGE_VT(STD_640_CA5_6L_D,	7);
	JUDGE_VT(STD_640_CA3_4H_R,	8);
	JUDGE_VT(STD_640_CA3_4L_R,	9);
	JUDGE_VT(STD_640_CA3_4H_D,	10);
	JUDGE_VT(STD_640_CA3_4L_D,	11);
	JUDGE_VT(STD_640_CA9H_R,	12);
	JUDGE_VT(STD_640_CA9L_R,	13);
	JUDGE_VT(STD_640_CA9H_D,	14);
	JUDGE_VT(STD_640_CA9L_D,	15);
	JUDGE_VT(STD_640_CA2H_R,	16);
	JUDGE_VT(STD_640_CA2L_R,	17);
	JUDGE_VT(STD_640_CA2H_D,	18);
	JUDGE_VT(STD_640_CA2L_D,	19);
	
//////////////////////////////////////////////////////////
	
//	CONTROL22	AD値読出
//	CONTROL23	AD値読出
	
	// CONTROL22 Base：PB_IGR_MONI
	// CONTROL23 Base：V_PB_1R8M
	ETH_BASE_SEND(
		"./"  CMD_PB_IGR_MONI
		"&./" CMD_V_PB_1R8M
		"&");
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		
		// CONTROL22 Base：PB_IGR_MONI
		if (!controls[21])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_PB_IGR_MONI, false) == 0)
			{
				fVTValue[0] = ETH_BASE_GETVALUE2();
				controls[21] = true;
			}
		}
		
		// CONTROL23 Base：V_PB_1R8M
		if (!controls[22])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_V_PB_1R8M, false) == 0)
			{
				fVTValue[1] = ETH_BASE_GETVALUE2();
				controls[22] = true;
			}
		}
	}
	while (
		   !controls[21]
		|| !controls[22]
		);
	JUDGE_VT(STD_640_IGR_AD,	0);
	JUDGE_VT(STD_640_PB_1R8AD,	1);
	
//	CONTROL24	AD値読出
	
