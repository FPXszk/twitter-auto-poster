			if (ETH_BASE_CHKRECV(RES_B_MD_ip_1, false) == 0)
			{
				// 注37
				fVTValue[0] = ETH_BASE_GETVALUE2(" ");
				fVTValue[0] = (int)fVTValue[0] & 0xABFF;
				fVTValue[1] = ETH_BASE_GETVALUE2();
				fVTValue[1] = (int)fVTValue[1] & 0x6FFF;
				controls[37] = true;
			}
		}
			
		if (!controls[39])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_MD_ip_2, false) == 0)
			{
				// 注37
				fVTValue[2] = ETH_BASE_GETVALUE2(" ");
				fVTValue[2] = (int)fVTValue[2] & 0x0000;
				fVTValue[3] = ETH_BASE_GETVALUE2();
				fVTValue[3] = (int)fVTValue[3] & 0x003B;
				controls[39] = true;
			}
		}
	}
	while (
		   !controls[37]
		|| !controls[39]
		);
