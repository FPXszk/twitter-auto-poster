	fVTValue[0] = 0;
	fVTValue[1] = 0;
	fVTValue[2] = 0;
	
	// CONTROL5 Base：B_PVM_Fr_mipi
	// CONTROL6 Base：B_PVM_L_mipi
	// CONTROL7 Base：B_PVM_R_mipi
	ETH_BASE_SEND(
		"./"  CMD_B_PVM_Fr_mipi
		"&./" CMD_B_PVM_L_mipi
		"&./" CMD_B_PVM_R_mipi
 		"&");
 	
 	// 応答待ち（複数同時なのでデフォルト監視できない）
 	WAIT(1000);
 	
	ETH_BASE_RECV(ETH_TIMEOUT, false);
	
	// CONTROL5 Base：B_PVM_Fr_mipi
	ETH_BASE_RESETPOINTER();
	// 注24：OKなら1、それ以外は0
	if (ETH_BASE_CHKRECV(RES_B_PVM_Fr_mipi, false) == 0)
	{
		fVTValue[0] = 1;
	}
	
	// CONTROL6 Base：B_PVM_L_mipi
