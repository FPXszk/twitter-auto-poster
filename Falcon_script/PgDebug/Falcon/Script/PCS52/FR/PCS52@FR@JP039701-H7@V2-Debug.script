		if (!controls[32])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RPRG_JDG_read, false) == 0)
			{
				// 注16-1：RESULT:1なら1、それ以外は0
