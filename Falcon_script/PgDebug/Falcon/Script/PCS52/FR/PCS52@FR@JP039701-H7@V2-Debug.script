StartStep 660, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 660 //////////");
	etherMidLog.Write("////////// STEP 660 //////////");
	
	bool controls[9];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	bool ctrl2ck[2];
	for (int i = 0; i < sizeof(ctrl2ck); i++)
	{
		ctrl2ck[i] = false;
	}
	
//	CONTROL1	GPIO書込/読出
	
	// CONTROL1 Mid：M_FANPWR_EN_on
	ETH_MID_SEND("./" CMD_M_FANPWR_EN_on);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_M_FANPWR_EN_on, false));
	
//	CONTROL2	GPIO書込/読出
	
	// CONTROL2 Mid：M_FAN1_PWM3_on
	ETH_MID_SEND("./" CMD_M_FAN1_PWM3_on);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		if (!ctrl2ck[0])
		{
			if (ETH_MID_CHKRECV(RES_M_FAN1_PWM3_on_1, false) == 0)
			{
				ctrl2ck[0]= true;
			}
		}
		if (!ctrl2ck[1])
		{
			if (ETH_MID_CHKRECV(RES_M_FAN1_PWM3_on_2, false) == 0)
			{
				ctrl2ck[1]= true;
			}
		}
	}
	while (!ctrl2ck[0] || !ctrl2ck[1]);
	
//	CONTROL3	GPIO書込/読出
	
	// CONTROL3 Base：B_DM_LED_EN_on
	ETH_BASE_SEND("./" CMD_B_DM_LED_EN_on);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_B_DM_LED_EN_on, false));
	
//	CONTROL4	GPIO書込/読出
	
	// CONTROL4 Mid：M_IR_EN_off
	ETH_MID_SEND("./" CMD_M_IR_EN_off);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_M_IR_EN_off, false));
	
//	CONTROL5	GPIO書込/読出
//	CONTROL6	GPIO書込/読出
//	CONTROL7	GPIO書込/読出
//	CONTROL8	GPIO書込/読出
//	CONTROL9	GPIO書込/読出
	
	// CONTROL5 Base：B_SOC_RST_TIMO_write_0
	// CONTROL7 Base：B_SOC_RPRG_JDG_write_0
	// CONTROL8 Base：B_SOC_SUF_JDG_write_0
	ETH_BASE_SEND(
		"./"  CMD_B_SOC_RST_TIMO_write_0
		"&./" CMD_B_SOC_RPRG_JDG_write_0
		"&./" CMD_B_SOC_SUF_JDG_write_0
		"&");
	// CONTROL6 Mid：M_SOC_RST_TIMI_write_0
	// CONTROL9 Mid：M_SOC_TIMESYNC_write_0
	ETH_MID_SEND(
		"./"  CMD_M_SOC_RST_TIMI_write_0
		"&./" CMD_M_SOC_TIMESYNC_write_0
		"&");
	
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL5 Base：B_SOC_RST_TIMO_write_0
		if (!controls[4])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_RST_TIMO_write_0, false) == 0)
			{
				controls[4] = true;
			}
		}
		
		// CONTROL6 Mid：M_SOC_RST_TIMI_write_0
		if (!controls[5])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RST_TIMI_write_0, false) == 0)
			{
				controls[5] = true;
			}
		}
		
		// CONTROL7 Base：B_SOC_RPRG_JDG_write_0
		if (!controls[6])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_RPRG_JDG_write_0, false) == 0)
			{
				controls[6] = true;
			}
		}
		
		// CONTROL8 Base：B_SOC_SUF_JDG_write_0
		if (!controls[7])
		{
			ETH_BASE_RESETPOINTER();
			if (ETH_BASE_CHKRECV(RES_B_SOC_SUF_JDG_write_0, false) == 0)
			{
				controls[7] = true;
			}
		}
		
		// CONTROL9  Mid：M_SOC_TIMESYNC_write_0
		if (!controls[8])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_TIMESYNC_write_0, false) == 0)
			{
				controls[8] = true;
			}
		}
	}
	while (
		   !controls[4]
		|| !controls[5]
		|| !controls[6]
		|| !controls[7]
		|| !controls[8]
		);
	
EndStep


/*-----------------------------------------------------
	STEP 670 
-----------------------------------------------------*/
StartStep 670, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS
	
	etherBaseLog.Write("////////// STEP 670 //////////");
	etherMidLog.Write("////////// STEP 670 //////////");
	
	bool controls[36];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	
	char cid[32];
	
//	SEQ1	CAN通信
	
	// 条件待ち：1s
	WAIT(1000);
	
	ETH_BASE_SEND("./" CMD_can_off);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_can_off, false));
	
//	CONTROL1	CANFD_CENT送信
	
	// CAN受信開始
	IntegCan->receiveDataReset("CANFD0-0");
	IntegCan->receive("CANFD0-0", 0, 0x123);
	
	// CONTROL1  Base：CANFD_CENT_TX
	ETH_BASE_SEND("./"  CMD_CANFD_CENT_TX);
	
	// 注3：CAN
	memset(g_szRecvData, 0x0, sizeof(g_szRecvData));
	iResult = IntegCan->receiveEvent("CANFD0-0", g_szRecvData, 1, 1500, 8);
	if (iResult == 1)
	{
		IntegCan->receiveData("CANFD0-0", g_szRecvData, 0, 0x123, 0, 0, 0, 7, 8);
//		Print("CANFD_CENT: %02x %02x %02x %02x %02x %02x %02x %02x",
//			(unsigned char)g_szRecvData[0],
//			(unsigned char)g_szRecvData[1],
//			(unsigned char)g_szRecvData[2],
//			(unsigned char)g_szRecvData[3],
//			(unsigned char)g_szRecvData[4],
//			(unsigned char)g_szRecvData[5],
//			(unsigned char)g_szRecvData[6],
//			(unsigned char)g_szRecvData[7]);
		if (((unsigned char)g_szRecvData[0] == 0xF8) &&
		    ((unsigned char)g_szRecvData[1] == 0x3E) &&
		    ((unsigned char)g_szRecvData[2] == 0x0F) &&
		    ((unsigned char)g_szRecvData[3] == 0x83) &&
		    ((unsigned char)g_szRecvData[4] == 0xE0) &&
		    ((unsigned char)g_szRecvData[5] == 0xF8) &&
		    ((unsigned char)g_szRecvData[6] == 0x3E) &&
		    ((unsigned char)g_szRecvData[7] == 0x0F))
		{
			fVTValue[0] = 1;
		}
		else
		{
			fVTValue[0] = 0;
		}
	}
	else
	{
		fVTValue[0] = 0;
	}
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_CANFD_CENT_TX, false));
	
	JUDGE_VT(STD_670_CA1_TX, 0);
	
	// CAN受信停止
	IntegCan->stopReceive("CANFD0-0");
	
//	CONTROL2	CANFD_FR_FL送信
	
	// CAN受信開始
	IntegCan->receiveDataReset("CANFD0-1");
	IntegCan->receive("CANFD0-1", 0, 0x123);
	
	// CONTROL2  Base：CANFD_FR_FL_TX
	ETH_BASE_SEND("./"  CMD_CANFD_FR_FL_TX);
	
	// 注3：CAN
