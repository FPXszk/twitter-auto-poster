	}
	while (ETH_MID_CHKRECV(RES_V_BU_1R8M, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_640_BU_1R8AD, 0);
	
//	CONTROL25	AD値読出
	
	// CONTROL25 Mid：BU_FANPWR_MONI
	ETH_MID_SEND("./" CMD_BU_FANPWR_MONI);
