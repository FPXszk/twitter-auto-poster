//			(unsigned char)g_szRecvData[6],
//			(unsigned char)g_szRecvData[7]);
		if (((unsigned char)g_szRecvData[0] == 0xF8) &&
		    ((unsigned char)g_szRecvData[1] == 0x3E) &&
		    ((unsigned char)g_szRecvData[2] == 0x0F) &&
		    ((unsigned char)g_szRecvData[3] == 0x83) &&
		    ((unsigned char)g_szRecvData[4] == 0xE0) &&
		    ((unsigned char)g_szRecvData[5] == 0xF8) &&
		    ((unsigned char)g_szRecvData[6] == 0x3E) &&
		    ((unsigned char)g_szRecvData[7] == 0x0F))
		{
			fVTValue[0] = 1;
		}
		else
		{
			fVTValue[0] = 0;
		}
	}
	else
	{
		fVTValue[0] = 0;
	}
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_CANFD_FR_FL_TX, false));
	
	JUDGE_VT(STD_670_CA5_6_TX, 0);
	
	// CAN受信停止
	IntegCan->stopReceive("CANFD0-1");
	
//	CONTROL3	CANFD_RR_RL送信
	
	// CAN受信開始
