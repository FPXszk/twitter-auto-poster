	ETH_BASE_SEND("./" CMD_CANFD_F_RX);
	WAIT(100);
	IntegCan->sendCharEvent("CANFD2-0", "F83E0F83E0F83E0F", 0x123);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_CANFD_F_RX, false));
	//注3：CAN
	fVTValue[0] = ETH_BASE_GETOKNG();
	JUDGE_VT(STD_710_CA2_RX, 0);
	
//	CONTROL5	CANFD_TRAI受信
	
	// CONTROL5  Base：CANFD_TRAI_RX
	ETH_BASE_SEND("./" CMD_CANFD_TRAI_RX);
	WAIT(100);
	IntegCan->sendCharEvent("CANFD1-1", "F83E0F83E0F83E0F", 0x123);
	do
	{
		ETH_BASE_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_BASE_CHKRECV(RES_CANFD_TRAI_RX, false));
	//注3：CAN
	fVTValue[0] = ETH_BASE_GETOKNG();
	JUDGE_VT(STD_710_CA9_RX, 0);

//	CONTROL6	PVMSW端子電圧測定
	
	SET_CH_SPEED(2);
	MEAS_VOLT(TP0A28_B0C16, TP0A21_B0C03, "A", 1000, 'M');			// CONTROL6
	JUDGE_VT(STD_710_P_DIV_CK, 0);
	
//	CONTROL7	AD値読出
	
	// 注39
	// CONTROL7 Mid：VSUP1_MONI_OFF
	ETH_MID_SEND("./" CMD_VSUP1_MONI_OFF);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}while (ETH_MID_CHKRECV(RES_VSUP1_MONI_OFF, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_710_V1_ADOFF, 0);
	
//	CONTROL8	AD値読出
	
	// CONTROL8 Mid：VSUP2_MONI_OFF
	ETH_MID_SEND("./" CMD_VSUP2_MONI_OFF);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_VSUP2_MONI_OFF, false));
	fVTValue[0] = ETH_MID_GETVALUE2();
	JUDGE_VT(STD_710_V2_ADOFF, 0);
	
EndStep


