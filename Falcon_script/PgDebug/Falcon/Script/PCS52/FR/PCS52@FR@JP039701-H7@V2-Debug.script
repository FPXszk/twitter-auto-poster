		ETH_BASE_RECV(ETH_TIMEOUT, false);
		ETH_MID_RECV(ETH_TIMEOUT, false);
		
		// CONTROL31 Mid：M_SOC_RST_TIMO_read
		if (!controls[30])
		{
			ETH_MID_RESETPOINTER();
			if (ETH_MID_CHKRECV(RES_M_SOC_RST_TIMO_read, false) == 0)
			{
				// 注16-1：RESULT:1なら1、それ以外は0
				if (ETH_MID_GETRESULT() == 1)
				{
					fVTValue[0] = 1;
				}
				else
