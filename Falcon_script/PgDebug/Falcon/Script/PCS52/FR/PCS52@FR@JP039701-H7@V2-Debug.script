	iResult = IntegCan->receiveEvent("CANFD0-1", g_szRecvData, 1, 1500, 8);
	if (iResult == 1)
	{
		IntegCan->receiveData("CANFD0-1", g_szRecvData, 0, 0x123, 0, 0, 0, 7, 8);
//		Print("CANFD_FR_FL: %02x %02x %02x %02x %02x %02x %02x %02x",
//			(unsigned char)g_szRecvData[0],
//			(unsigned char)g_szRecvData[1],
