	}
	while (ETH_MID_CHKRECV(RES_M_SER_GPIO1_1, false));
	
//	SEQ3	対向機側MM用DesのGPIOモニタ1レジスタ読出し_H
	
	// 注61
	gvif_readI2cReg(GVIF_MODLE_IPADDR, 0, 0x26, 0x0A, 0xED, &o_gpio_h_reg);
	
	// 注63：受信データが0x33なら1
	if (o_gpio_h_reg == 0x33)
