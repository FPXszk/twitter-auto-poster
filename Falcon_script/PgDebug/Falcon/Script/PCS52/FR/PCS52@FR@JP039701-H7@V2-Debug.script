-----------------------------------------------------*/
StartStep 680, 60000, cmTimeoutAbort
#include	LOCALPARAMS
#include	LOCALMACROS

	etherBaseLog.Write("////////// STEP 680 //////////");
	etherMidLog.Write("////////// STEP 680 //////////");
	
	bool controls[6];
	for (int i = 0; i < sizeof(controls); i++)
	{
		controls[i] = false;
	}
	bool ctrl3ck[2];
	for (int i = 0; i < sizeof(ctrl3ck); i++)
	{
		ctrl3ck[i] = false;
	}
	bool ctrl4ck[2];
	for (int i = 0; i < sizeof(ctrl4ck); i++)
	{
		ctrl4ck[i] = false;
	}
	
//	CONTROL1	elmos IC リセット
	
	// 注39
	// CONTROL1 Mid：DSIA_RST
	ETH_MID_SEND("./" CMD_DSIA_RST);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSIA_RST, false));
	
//	CONTROL2	elmos IC リセット
	
	// CONTROL2 Mid：DSIB_RST
	ETH_MID_SEND("./" CMD_DSIB_RST);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSIB_RST, false));
	
//	CONTROL3	PWM出力
	
	// 注39
	// CONTROL3 Mid：DSIA_pwm
	ETH_MID_SEND("./" CMD_DSIA_pwm);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		if (!ctrl3ck[0])
		{
			if (ETH_MID_CHKRECV(RES_DSIA_pwm_1, false) == 0)
			{
				ctrl3ck[0] = true;
			}
		}
		if (!ctrl3ck[1])
		{
			if (ETH_MID_CHKRECV(RES_DSIA_pwm_2, false) == 0)
			{
					ctrl3ck[1] = true;
			}
		}
	}
	while (!ctrl3ck[0] || !ctrl3ck[1]);
	
//	CONTROL4	PWM出力
	
	// CONTROL4 Mid：DSIB_pwm
	ETH_MID_SEND("./" CMD_DSIB_pwm);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
		if (!ctrl4ck[0])
		{
			if (ETH_MID_CHKRECV(RES_DSIB_pwm_1, false) == 0)
			{
				ctrl4ck[0] = true;
			}
		}
		if (!ctrl4ck[1])
		{
			if (ETH_MID_CHKRECV(RES_DSIB_pwm_2, false) == 0)
			{
				ctrl4ck[1] = true;
			}
		}
	}
	while (!ctrl4ck[0] || !ctrl4ck[1]);
	
//	CONTROL5	レジスタクリア
	
	// 注39
	// CONTROL5 Mid：DSIA_clear
	ETH_MID_SEND("./" CMD_DSIA_clear);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSIA_clear, false));
	
//	CONTROL6	レジスタクリア
	
	// CONTROL6 Mid：DSIB_clear
	ETH_MID_SEND("./" CMD_DSIB_clear);
	do
	{
		ETH_MID_RECV(ETH_TIMEOUT, false);
	}
	while (ETH_MID_CHKRECV(RES_DSIB_clear, false));
	
EndStep


