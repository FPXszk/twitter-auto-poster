	if (iResult == 1)
	{
		IntegCan->receiveData("CANFD1-0", g_szRecvData, 0, 0x123, 0, 0, 0, 7, 8);
//		Print("CANFD_RR_RL: %02x %02x %02x %02x %02x %02x %02x %02x",
//			(unsigned char)g_szRecvData[0],
//			(unsigned char)g_szRecvData[1],
//			(unsigned char)g_szRecvData[2],
//			(unsigned char)g_szRecvData[3],
